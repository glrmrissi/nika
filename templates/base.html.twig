<!DOCTYPE html>
<html lang="ja" data-theme="dark">
<head>
  <script>!function(){var t=localStorage.getItem('theme');document.documentElement.setAttribute('data-theme',t||'dark')}();</script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}nika{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="{{ asset('css/base.css') }}">
  <link rel="stylesheet" href="{{ asset('css/dark.css') }}">
  <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
  <link rel="stylesheet" href="{{ asset('css/components/topbar.css') }}">
  <link rel="stylesheet" href="{{ asset('css/components/mobile-nav.css') }}">
  <link rel="stylesheet" href="{{ asset('css/components/ui.css') }}">
  {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
  <div class="app-layout">
    {% block topbar %}
      {% include 'components/topbar.html.twig' %}
    {% endblock %}

    <div class="app-content">
      {% block body %}{% endblock %}
    </div>
  </div>

  {% block mobile_nav %}
    {% include 'components/mobile-nav.html.twig' %}
  {% endblock %}

  <script src="{{ asset('js/base.js') }}"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
