{% extends 'base.html.twig' %}

{% block title %}Kanji | nika{% endblock %}

{% block stylesheets %}
<style>
.kanji-browser { max-width: 800px; margin: 0 auto; }
.kanji-browser__header { margin-bottom: 24px; }
.kanji-browser__toolbar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px; }
.kanji-browser__filter { padding: 6px 16px; border-radius: var(--radius-full); border: 1px solid var(--color-outline-variant); background: var(--color-surface-container-lowest); font-size: 13px; font-weight: 500; cursor: pointer; transition: border-color var(--transition-fast), color var(--transition-fast); color: var(--color-on-surface); }
.kanji-browser__filter--active { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
.kanji-browser__toolbar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 24px; }
.kanji-browser__filters { display: flex; gap: 8px; flex-wrap: wrap; flex: 1; }
.kanji-browser__actions { display: flex; gap: 8px; flex-shrink: 0; }
.kanji-browser__tabs { display: flex; gap: 4px; margin-bottom: 16px; background: var(--color-surface-container); border-radius: var(--radius-full); width: fit-content; }
.kanji-browser__action { padding: 6px 16px; border-radius: var(--radius-full); border: 1px solid var(--color-outline-variant); background: var(--color-surface-container-lowest); font-size: 13px; font-weight: 500; cursor: pointer; transition: border-color var(--transition-fast), opacity var(--transition-fast); color: var(--color-on-surface); }
.kanji-browser__action--primary { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
.kanji-browser__tab { padding: 6px 16px; border-radius: var(--radius-full); font-size: 13px; font-weight: 500; cursor: pointer; transition: color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast); color: var(--color-secondary); border: none; background: none; }
.kanji-browser__tab--active { background: var(--color-surface-container-lowest); color: var(--color-on-surface); box-shadow: var(--shadow-card); }
.kanji-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
.kanji-grid__item { background: var(--color-surface-container-low); border-radius: var(--radius-md); padding: 12px 8px 8px; text-align: center; cursor: pointer; transition: background var(--transition-fast); border: 2px solid transparent; position: relative; animation: kanji-item-in 0.3s var(--ease-out) both; }

@keyframes kanji-item-in { from { opacity: 0; } to { opacity: 1; } }
.kanji-grid__item--selected { border-color: var(--color-primary); }
.kanji-grid__item--done { opacity: 0.55; }
.kanji-grid__item--done:hover { opacity: 0.75; }
.kanji-grid__item--done .kanji-grid__char { text-decoration: line-through; text-decoration-color: var(--color-primary); }
.kanji-grid__char { font-size: 28px; font-weight: 500; line-height: 1.2; }
.kanji-grid__reading { font-size: 12px; color: var(--color-secondary); margin-top: 4px; }
.kanji-grid__meaning { font-size: 12px; color: var(--color-on-surface-variant); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kanji-grid__trophy { position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; line-height: 1; }
.kanji-grid__trophy img { width: 18px; height: 18px; object-fit: contain; display: block; }
.kanji-grid__search-btn { position: absolute; bottom: 4px; right: 4px; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--color-secondary); cursor: pointer; border-radius: var(--radius-sm); transition: color var(--transition-fast); line-height: 1; text-decoration: none; }
.kanji-grid__search-btn:hover { color: var(--color-primary); }
.kanji-grid__select { position: absolute; top: 4px; left: 4px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--color-outline-variant); background: var(--color-surface-container-lowest); display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--color-on-primary); cursor: pointer; transition: border-color var(--transition-fast), background var(--transition-fast); line-height: 1; padding: 0; }
.kanji-grid__select:hover { border-color: var(--color-primary); }
.kanji-grid__select--on { background: var(--color-primary); border-color: var(--color-primary); }
.kanji-grid__char { cursor: pointer; }
.kanji-grid__char--auto { cursor: pointer; }
.pagination { display: flex; justify-content: center; gap: 8px; margin-top: 24px; flex-wrap: wrap; }
.pagination__btn { padding: 6px 14px; border-radius: var(--radius-md); border: 1px solid var(--color-outline-variant); font-size: 13px; font-weight: 500; background: var(--color-surface-container-lowest); cursor: pointer; transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast); color: var(--color-on-surface); }
.pagination__btn:hover { border-color: var(--color-primary); }
.pagination__btn--active { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
.pagination__btn:disabled { opacity: 0.4; cursor: not-allowed; }
.kanji-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 200; align-items: center; justify-content: center; padding: 24px; }
.kanji-modal--open { display: flex; }
.kanji-modal__content { background: var(--color-surface-container-lowest); border-radius: var(--radius-xl); padding: 32px; max-width: 400px; width: 100%; text-align: center; position: relative; }
.kanji-modal__close { position: absolute; top: 12px; right: 12px; font-size: 20px; color: var(--color-secondary); cursor: pointer; }
.kanji-modal__char { font-size: 64px; font-weight: 700; line-height: 1.2; margin-bottom: 16px; }
.kanji-modal__reading { display: flex; justify-content: center; gap: 24px; margin-bottom: 8px; }
.kanji-modal__onyomi { color: #ff9f0a; }
.kanji-modal__kunyomi { color: #34c759; }
.kanji-modal__meanings { font-size: 16px; color: var(--color-on-surface); margin-bottom: 8px; }
.kanji-modal__meta { font-size: 12px; color: var(--color-secondary); }
.kanji-modal__img-search { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: var(--color-secondary); text-decoration: none; transition: color var(--transition-fast); }
.kanji-modal__img-search:hover { color: var(--color-primary); }
.kanji-modal__searches { display: flex; gap: 16px; justify-content: center; margin-top: 8px; }
.kanji-modal__actions { display: flex; gap: 8px; margin-top: 20px; justify-content: center; }
.kanji-modal__btn { padding: 8px 20px; border-radius: var(--radius-md); font-size: 13px; font-weight: 600; cursor: pointer; transition: background var(--transition-fast), opacity var(--transition-fast), border-color var(--transition-fast); border: none; }
.kanji-modal__btn--primary { background: var(--color-primary); color: var(--color-on-primary); }
.kanji-modal__btn--primary:hover { opacity: 0.9; }
.kanji-modal__btn--secondary { background: var(--color-surface-container); color: var(--color-on-surface); border: 1px solid var(--color-outline-variant); }
.kanji-modal__btn--secondary:hover { background: var(--color-surface-container-high); }
.kanji-modal__btn--success { background: #34c759; color: #fff; }
.kanji-modal__btn--success:hover { background: #2db74e; }
.kanji-modal__btn--danger { background: var(--color-error); color: #fff; }
.kanji-modal__btn--danger:hover { opacity: 0.9; }
.kanji-browser__loading { text-align: center; padding: 40px; color: var(--color-secondary); }
.toast-container { position: fixed; bottom: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; pointer-events: none; }
.toast { padding: 12px 20px; border-radius: var(--radius-md); font-size: 14px; font-weight: 500; background: var(--color-inverse-surface); color: var(--color-inverse-on-surface); box-shadow: var(--shadow-modal); pointer-events: auto; max-width: 360px; animation: toast-in 0.3s var(--ease-out) forwards; }
.toast--out { animation: toast-out 0.25s var(--ease-out) forwards; }
.toast--success { background: #1a7d36; color: #fff; }
.toast--error { background: var(--color-error); color: var(--color-on-error); }
@keyframes toast-in { 0% { transform: translateX(100%); opacity: 0; } 100% { transform: translateX(0); opacity: 1; } }
@keyframes toast-out { 0% { transform: translateX(0); opacity: 1; } 100% { transform: translateX(100%); opacity: 0; } }
@media (hover: hover) and (pointer: fine) {
  .kanji-browser__filter:hover { border-color: var(--color-primary); }
  .kanji-browser__action:hover { border-color: var(--color-primary); }
  .kanji-browser__action--primary:hover { opacity: 0.9; }
  .kanji-browser__tab:hover { color: var(--color-on-surface); }
  .kanji-grid__item:hover { background: var(--color-surface-container); border-color: var(--color-outline-variant); }
  .kanji-grid__item--done:hover { opacity: 0.75; }
  .kanji-grid__search-btn:hover { color: var(--color-primary); }
  .kanji-grid__select:hover { border-color: var(--color-primary); }
  .pagination__btn:hover { border-color: var(--color-primary); }
  .kanji-modal__img-search:hover { color: var(--color-primary); }
  .kanji-modal__btn--primary:hover { opacity: 0.9; }
  .kanji-modal__btn--secondary:hover { background: var(--color-surface-container-high); }
  .kanji-modal__btn--success:hover { background: #2db74e; }
  .kanji-modal__btn--danger:hover { opacity: 0.9; }
}
@media (max-width: 480px) { .kanji-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
{% endblock %}

{% block body %}
<div class="kanji-browser">
  <div class="kanji-browser__header">
    <h2 class="page-title">Kanji</h2>
    <p class="page-subtitle">Browse kanji JLPT N5 to N1. Click the circle to select for study. Click the external link icon to open in Jisho.</p>
  </div>

  <div class="kanji-browser__tabs" id="tabs">
    <button class="kanji-browser__tab kanji-browser__tab--active" data-status="">All</button>
    <button class="kanji-browser__tab" data-status="studying">Studying</button>
    <button class="kanji-browser__tab" data-status="complete">Done</button>
  </div>

  <div class="kanji-browser__toolbar">
    <div class="kanji-browser__filters" id="filters">
      <button class="kanji-browser__filter kanji-browser__filter--active" data-level="">All Levels</button>
      <button class="kanji-browser__filter" data-level="N5">N5</button>
      <button class="kanji-browser__filter" data-level="N4">N4</button>
      <button class="kanji-browser__filter" data-level="N3">N3</button>
      <button class="kanji-browser__filter" data-level="N2">N2</button>
      <button class="kanji-browser__filter" data-level="N1">N1</button>
    </div>
    <div class="kanji-browser__actions" id="actions">
      <button class="kanji-browser__action kanji-browser__action--primary" id="select-all-btn">Select All</button>
      <button class="kanji-browser__action" id="deselect-all-btn">Deselect All</button>
    </div>
  </div>

  <div id="kanji-grid" class="kanji-grid"></div>

  <div class="pagination" id="pagination"></div>
</div>

<div class="kanji-modal" id="kanji-modal">
  <div class="kanji-modal__content">
    <span class="kanji-modal__close" id="modal-close">&times;</span>
    <div class="kanji-modal__char" id="modal-char"></div>
    <div class="kanji-modal__reading">
      <span class="kanji-modal__onyomi" id="modal-onyomi"></span>
      <span class="kanji-modal__kunyomi" id="modal-kunyomi"></span>
    </div>
    <div class="kanji-modal__meanings" id="modal-meanings"></div>
    <div class="kanji-modal__meta" id="modal-meta"></div>
    <div class="kanji-modal__searches">
      <a href="#" class="kanji-modal__img-search" id="modal-search-jisho" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Open in Jisho</a>
    </div>
    <div class="kanji-modal__actions" id="modal-actions"></div>
  </div>
</div>

<div class="toast-container" id="toast-container"></div>
{% endblock %}

{% block javascripts %}
<script nonce="{{ csp_nonce('script') }}">
var currentPage = 1;
var currentLevel = '';
var currentStatus = '';
var totalPages = 1;
var isAuthenticated = {{ app.user ? 'true' : 'false' }};
var kanjiClickAction = '{{ kanjiClickAction }}';
var csrfToken = '{{ csrf_token('api') }}';

function escapeHtml(str) {
  if (!str) return '';
  var div = document.createElement('div');
  div.appendChild(document.createTextNode(str));
  return div.innerHTML;
}

function imageSearchUrl(char) {
  return 'https://jisho.org/search/' + encodeURIComponent(char);
}

function getCacheKey(page, level, status) {
  return 'kanji_list_' + page + '_' + (level || 'all') + '_' + (status || 'all');
}

function getFromCache(page, level, status) {
  var key = getCacheKey(page, level, status);
  var cached = localStorage.getItem(key);
  if (!cached) return null;
  try {
    var data = JSON.parse(cached);
    if (Date.now() - data.ts < 3600000) return data.payload;
  } catch(e) {}
  localStorage.removeItem(key);
  return null;
}

function setCache(page, level, status, payload) {
  var key = getCacheKey(page, level, status);
  localStorage.setItem(key, JSON.stringify({ ts: Date.now(), payload: payload }));
}

function invalidateCache() {
  for (var i = localStorage.length - 1; i >= 0; i--) {
    var key = localStorage.key(i);
    if (key && key.indexOf('kanji_list_') === 0) {
      localStorage.removeItem(key);
    }
  }
}

function showToast(msg, type) {
  var container = document.getElementById('toast-container');
  while (container.children.length >= 3) {
    if (container.lastChild) container.lastChild.remove();
  }
  var el = document.createElement('div');
  el.className = 'toast';
  if (type === 'success') el.classList.add('toast--success');
  else if (type === 'error') el.classList.add('toast--error');
  el.textContent = msg;
  container.insertBefore(el, container.firstChild);
  setTimeout(function () {
    if (!el.parentNode) return;
    el.classList.add('toast--out');
    setTimeout(function () { if (el.parentNode) el.remove(); }, 250);
  }, 3000);
}

function fetchKanji(page, level, status) {
  var cached = getFromCache(page, level, status);
  if (cached) {
    renderKanji(cached);
    return;
  }

  var grid = document.getElementById('kanji-grid');
  grid.innerHTML = '<div class="kanji-browser__loading">Loading...</div>';

  var params = new URLSearchParams({ page: page, limit: 50 });
  if (level) params.set('level', level);
  if (status) params.set('status', status);

  fetch('/api/kanji?' + params.toString())
    .then(function (r) { return r.json(); })
    .then(function (data) {
      setCache(page, level, status, data);
      renderKanji(data);
    });
}

function renderKanji(data) {
  var grid = document.getElementById('kanji-grid');
  var pagination = document.getElementById('pagination');

  currentPage = data.page;
  totalPages = data.pages;

  if (!data.data || data.data.length === 0) {
    grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--color-secondary);padding:40px;">No kanji found.</p>';
    pagination.innerHTML = '';
    return;
  }

  var html = '';
  data.data.forEach(function (k, idx) {
    var onyomi = k.onyomi || '';
    var meaning = k.meanings ? k.meanings.split(',')[0].trim() : '';
    var selected = k.selected ? ' kanji-grid__item--selected' : '';
    var done = k.done ? ' kanji-grid__item--done' : '';
    var selDot = k.selected ? ' kanji-grid__select--on' : '';
    var trophy = k.done ? '<span class="kanji-grid__trophy"><img src="{{ asset('assets/anime-happy.png') }}" alt="done"></span>' : '';
    var char = escapeHtml(k.character);
    var kun = escapeHtml(k.kunyomi || '');
    var mng = escapeHtml(meaning);
    var lvl = escapeHtml(k.jlptLevel || '');

    html += '<div class="kanji-grid__item' + selected + done + '" style="animation-delay:' + (idx * 20) + 'ms" data-id="' + k.id + '" data-char="' + char + '" data-onyomi="' + escapeHtml(onyomi) + '" data-kun="' + kun + '" data-mng="' + mng + '" data-lvl="' + lvl + '" data-selected="' + (k.selected ? '1' : '0') + '" data-done="' + (k.done ? '1' : '0') + '">';
    html += '<div class="kanji-grid__char">' + char + '</div>';
    html += '<div class="kanji-grid__reading">' + escapeHtml(onyomi) + '</div>';
    html += '<div class="kanji-grid__meaning">' + mng + '</div>';
    html += trophy;
    html += '<a href="' + imageSearchUrl(k.character) + '" target="_blank" rel="noopener" class="kanji-grid__search-btn" title="Open in Jisho"><i class="bi bi-box-arrow-up-right"></i></a>';
    html += '<span class="kanji-grid__select' + selDot + '" data-id="' + k.id + '" data-selected="' + (k.selected ? '1' : '0') + '">' + (k.selected ? '\u2713' : '') + '</span>';
    html += '</div>';
  });
  grid.innerHTML = html;

  var phtml = '';
  phtml += '<button class="pagination__btn" data-page="' + (currentPage - 1) + '" ' + (currentPage <= 1 ? 'disabled' : '') + '>&laquo;</button>';

  if (totalPages <= 7) {
    for (var i = 1; i <= totalPages; i++) {
      phtml += '<button class="pagination__btn ' + (i === currentPage ? 'pagination__btn--active' : '') + '" data-page="' + i + '">' + i + '</button>';
    }
  } else {
    phtml += '<button class="pagination__btn ' + (1 === currentPage ? 'pagination__btn--active' : '') + '" data-page="1">1</button>';

    var start = Math.max(2, currentPage - 2);
    var end = Math.min(totalPages - 1, currentPage + 2);

    if (start > 2) {
      phtml += '<span style="padding:6px 4px;color:var(--color-secondary);">&hellip;</span>';
    }

    for (var i = start; i <= end; i++) {
      phtml += '<button class="pagination__btn ' + (i === currentPage ? 'pagination__btn--active' : '') + '" data-page="' + i + '">' + i + '</button>';
    }

    if (end < totalPages - 1) {
      phtml += '<span style="padding:6px 4px;color:var(--color-secondary);">&hellip;</span>';
    }

    phtml += '<button class="pagination__btn ' + (totalPages === currentPage ? 'pagination__btn--active' : '') + '" data-page="' + totalPages + '">' + totalPages + '</button>';
  }

  phtml += '<button class="pagination__btn" data-page="' + (currentPage + 1) + '" ' + (currentPage >= totalPages ? 'disabled' : '') + '>&raquo;</button>';
  pagination.innerHTML = phtml;
}

function goToPage(page) {
  if (page < 1 || page > totalPages) return;
  currentPage = page;
  fetchKanji(page, currentLevel, currentStatus);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

var _modalData = null;

function showDetail(id, char, onyomi, kunyomi, meanings, level, selected, done) {
  _modalData = { id: id, selected: selected, done: done };
  document.getElementById('modal-char').textContent = char;
  document.getElementById('modal-onyomi').textContent = '\u97F3: ' + onyomi;
  document.getElementById('modal-kunyomi').textContent = '\u8A13: ' + kunyomi;
  document.getElementById('modal-meanings').textContent = meanings;
  document.getElementById('modal-meta').textContent = level || '';
  document.getElementById('modal-search-jisho').href = imageSearchUrl(char);

  var actions = document.getElementById('modal-actions');
  if (!isAuthenticated) {
    actions.innerHTML = '';
  } else {
    var selectLabel = _modalData.selected ? 'Remove from Study' : 'Add to Study';
    var selectCls = _modalData.selected ? 'kanji-modal__btn--danger' : 'kanji-modal__btn--primary';
    var doneLabel = _modalData.done ? 'Mark Incomplete' : 'Mark as Done';
    var doneCls = _modalData.done ? 'kanji-modal__btn--secondary' : 'kanji-modal__btn--success';
    actions.innerHTML =
      '<button class="kanji-modal__btn ' + selectCls + '" data-action="toggle-select">' + selectLabel + '</button>' +
      (_modalData.selected ? '<button class="kanji-modal__btn ' + doneCls + '" data-action="toggle-done">' + doneLabel + '</button>' : '');
  }

  document.getElementById('kanji-modal').classList.add('kanji-modal--open');
}

function closeModal() {
  document.getElementById('kanji-modal').classList.remove('kanji-modal--open');
  _modalData = null;
}

function modalToggleSelect() {
  if (!_modalData) return;
  toggleSelect(_modalData.id, null, function (selected) {
    _modalData.selected = selected;
    showDetail(
      _modalData.id,
      document.getElementById('modal-char').textContent,
      document.getElementById('modal-onyomi').textContent.replace('\u97F3: ', ''),
      document.getElementById('modal-kunyomi').textContent.replace('\u8A13: ', ''),
      document.getElementById('modal-meanings').textContent,
      document.getElementById('modal-meta').textContent,
      _modalData.selected,
      _modalData.done
    );
  });
}

function modalToggleDone() {
  if (!_modalData || !_modalData.selected) return;
  fetch('/kanji/' + _modalData.id + '/toggle-done', {
    method: 'POST',
    headers: { 'X-CSRF-Token': csrfToken }
  })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      _modalData.done = data.done;
      showToast(data.done ? 'Marked as done' : 'Marked as incomplete', 'success');
      invalidateCache();
      fetchKanji(currentPage, currentLevel, currentStatus);
      showDetail(
        _modalData.id,
        document.getElementById('modal-char').textContent,
        document.getElementById('modal-onyomi').textContent.replace('\u97F3: ', ''),
        document.getElementById('modal-kunyomi').textContent.replace('\u8A13: ', ''),
        document.getElementById('modal-meanings').textContent,
        document.getElementById('modal-meta').textContent,
        _modalData.selected,
        _modalData.done
      );
    });
}

function toggleSelect(kanjiId, el, cb) {
  fetch('/kanji/' + kanjiId + '/select', {
    method: 'POST',
    headers: { 'X-CSRF-Token': csrfToken }
  })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (el) {
        var item = el.closest('.kanji-grid__item');
        if (data.selected) {
          el.classList.add('kanji-grid__select--on');
          el.textContent = '\u2713';
          el.dataset.selected = '1';
          if (item) item.classList.add('kanji-grid__item--selected');
        } else {
          el.classList.remove('kanji-grid__select--on');
          el.textContent = '';
          el.dataset.selected = '0';
          if (item) item.classList.remove('kanji-grid__item--selected');
        }
      }
      invalidateCache();
      fetchKanji(currentPage, currentLevel, currentStatus);
      showToast(data.selected ? 'Added to study list' : 'Removed from study list', data.selected ? 'success' : 'error');
      if (cb) cb(data.selected);
    });
}

function batchSelect(action) {
  if (!isAuthenticated) { showToast('Sign in to select kanji', 'error'); return; }
  var btn = document.getElementById(action === 'select' ? 'select-all-btn' : 'deselect-all-btn');
  btn.disabled = true;
  btn.textContent = '...';

  var body = { action: action };
  if (currentLevel) {
    body.level = currentLevel;
  } else {
    var ids = [];
    var items = document.querySelectorAll('#kanji-grid .kanji-grid__item');
    items.forEach(function (el) {
      var id = parseInt(el.getAttribute('data-id'));
      if (id) ids.push(id);
    });
    body.ids = ids;
  }

  fetch('/api/kanji/select-batch', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify(body)
  })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.success) {
        var msg = action === 'select' ? 'Added ' + data.count + ' kanji' : 'Removed ' + data.count + ' kanji';
        showToast(msg, 'success');
        invalidateCache();
        fetchKanji(currentPage, currentLevel, currentStatus);
      } else if (data.error) {
        showToast(data.error, 'error');
      }
    })
    .catch(function () {
      showToast('Something went wrong', 'error');
    })
    .finally(function () {
      btn.disabled = false;
      btn.textContent = action === 'select' ? 'Select All' : 'Deselect All';
    });
}

document.addEventListener('DOMContentLoaded', function () {
  document.getElementById('modal-close').addEventListener('click', closeModal);

  document.getElementById('kanji-modal').addEventListener('click', function (e) {
    if (e.target === this) closeModal();
  });

  document.getElementById('modal-actions').addEventListener('click', function (e) {
    var btn = e.target.closest('.kanji-modal__btn');
    if (!btn) return;
    if (btn.dataset.action === 'toggle-select') modalToggleSelect();
    if (btn.dataset.action === 'toggle-done') modalToggleDone();
  });

  document.getElementById('kanji-grid').addEventListener('click', function (e) {
    var item = e.target.closest('.kanji-grid__item');
    if (!item) return;

    if (e.target.closest('.kanji-grid__search-btn')) return;
    if (e.target.closest('.kanji-grid__select')) {
      toggleSelect(parseInt(item.dataset.id), e.target.closest('.kanji-grid__select'));
      return;
    }

    if (kanjiClickAction === 'auto') {
      if (e.target.closest('.kanji-grid__char')) {
        window.open(imageSearchUrl(item.dataset.char), '_blank');
        return;
      }
      if (e.target.closest('.kanji-grid__reading') || e.target.closest('.kanji-grid__meaning')) {
        showDetail(
          parseInt(item.dataset.id),
          item.dataset.char,
          item.dataset.onyomi,
          item.dataset.kun,
          item.dataset.mng,
          item.dataset.lvl,
          parseInt(item.dataset.selected),
          parseInt(item.dataset.done)
        );
        return;
      }
      window.open(imageSearchUrl(item.dataset.char), '_blank');
      return;
    }

    if (e.target.closest('.kanji-grid__char')) return;

    showDetail(
      parseInt(item.dataset.id),
      item.dataset.char,
      item.dataset.onyomi,
      item.dataset.kun,
      item.dataset.mng,
      item.dataset.lvl,
      parseInt(item.dataset.selected),
      parseInt(item.dataset.done)
    );
  });

  document.getElementById('pagination').addEventListener('click', function (e) {
    var btn = e.target.closest('.pagination__btn');
    if (btn && !btn.disabled) {
      goToPage(parseInt(btn.dataset.page));
    }
  });

  var tabBtns = document.querySelectorAll('.kanji-browser__tab');
  tabBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabBtns.forEach(function (b) { b.classList.remove('kanji-browser__tab--active'); });
      this.classList.add('kanji-browser__tab--active');
      currentStatus = this.getAttribute('data-status') || '';
      currentPage = 1;
      fetchKanji(currentPage, currentLevel, currentStatus);
    });
  });

  var filterBtns = document.querySelectorAll('.kanji-browser__filter');
  filterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filterBtns.forEach(function (b) { b.classList.remove('kanji-browser__filter--active'); });
      this.classList.add('kanji-browser__filter--active');
      currentLevel = this.getAttribute('data-level') || '';
      currentPage = 1;
      fetchKanji(currentPage, currentLevel, currentStatus);
    });
  });

  document.getElementById('select-all-btn').addEventListener('click', function () {
    batchSelect('select');
  });

  document.getElementById('deselect-all-btn').addEventListener('click', function () {
    batchSelect('deselect');
  });

  fetchKanji(1, '', '');
});
</script>
{% endblock %}
