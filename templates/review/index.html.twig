{% extends 'base.html.twig' %}

{% block title %}Review | KanjiReview{% endblock %}

{% block body_class %}review-page{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/pages/review.css') }}">
{% endblock %}

{% block body %}
  <div class="review-container">
    <div id="review-area" style="display:none;flex-direction:column;align-items:center;width:100%;">
      <div class="review-card">
        <div class="review-card__char" id="kanji-char"></div>
        <div class="review-card__info" id="kanji-info">
          <div class="review-card__reading">
            <span class="review-card__onyomi" id="kanji-onyomi"></span>
            <span class="review-card__kunyomi" id="kanji-kunyomi"></span>
          </div>
          <div class="review-card__meanings" id="kanji-meanings"></div>
          <div class="review-card__meta" id="kanji-level"></div>
        </div>
      </div>

      <div class="review-actions">
        <button id="show-answer-btn" class="btn btn--primary review-actions__show" onclick="showAnswer()">
          Show Answer
        </button>
        <div id="quality-buttons" style="display:none;">
          <p class="review-actions__label">How well did you know it?</p>
          <div class="review-actions__buttons">
            <button class="btn btn--danger btn--sm" onclick="submitReview(0)">0 — Forgot</button>
            <button class="btn btn--danger btn--sm" onclick="submitReview(1)">1</button>
            <button class="btn btn--medium btn--sm" onclick="submitReview(2)">2</button>
            <button class="btn btn--medium btn--sm" onclick="submitReview(3)">3 — Hard</button>
            <button class="btn btn--success btn--sm" onclick="submitReview(4)">4 — Easy</button>
            <button class="btn btn--success btn--sm" onclick="submitReview(5)">5 — Perfect</button>
          </div>
        </div>
      </div>
    </div>

    <p class="review-progress" id="review-progress"></p>

    {% if dueCount > 0 %}
      <button class="btn btn--primary" onclick="startReview()" style="margin-top:16px;">
        Start Review ({{ dueCount }})
      </button>
    {% else %}
      <p style="color:var(--color-secondary);margin-top:16px;">No kanji due for review.</p>
    {% endif %}
  </div>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/pages/review.js') }}"></script>
<script>total = {{ dueCount }};</script>
{% endblock %}
