<header class="topbar">
  <div class="topbar__start">
    <button class="topbar__hamburger" id="sidebar-toggle" aria-label="Menu">
      <i class="bi bi-list"></i>
    </button>
    <div class="topbar__brand">
      <h2>nika</h2>
    </div>
    <nav class="topbar__nav">
      <a href="{{ path('app_home') }}" class="topbar__nav-link {% if app.current_route == 'app_home' %}topbar__nav-link--active{% endif %}">Dashboard</a>
      <a href="{{ path('app_review') }}" class="topbar__nav-link {% if app.current_route == 'app_review' %}topbar__nav-link--active{% endif %}">Review</a>
      <a href="{{ path('app_review_interactive') }}" class="topbar__nav-link {% if app.current_route == 'app_review_interactive' %}topbar__nav-link--active{% endif %}">Interactive</a>
      <a href="{{ path('app_kanji_list') }}" class="topbar__nav-link {% if app.current_route == 'app_kanji_list' %}topbar__nav-link--active{% endif %}">Kanji</a>
      <a href="{{ path('app_grammar_list') }}" class="topbar__nav-link {% if app.current_route == 'app_grammar_list' %}topbar__nav-link--active{% endif %}">Particles</a>
      <a href="{{ path('app_grammar_review') }}" class="topbar__nav-link {% if app.current_route == 'app_grammar_review' %}topbar__nav-link--active{% endif %}">P-Review</a>
      <a href="{{ path('app_grammar_quiz') }}" class="topbar__nav-link {% if app.current_route == 'app_grammar_quiz' %}topbar__nav-link--active{% endif %}">P-Quiz</a>
    </nav>
  </div>

  <div class="topbar__end">
    <a href="https://github.com/glrmrissi" target="_blank" rel="noopener" class="topbar__icon-btn" title="GitHub">
      <i class="bi bi-github"></i>
    </a>
    <button class="topbar__icon-btn" id="theme-toggle" title="Toggle theme">
      <i class="bi bi-sun" id="theme-toggle-icon"></i>
    </button>

    {% if app.user %}
      {% set _streak = app_streak() %}
      <div class="topbar__icon-btn topbar__streak" data-tooltip="{{ _streak }} day streak">
        <i class="bi bi-fire"></i>
        {% if _streak > 0 %}
          <span class="topbar__streak-count">{{ _streak }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% if app.user %}
      <div class="topbar__user-menu">
        <button class="topbar__avatar" title="{{ app.user.name }}">
          {% if app.user.avatarPath %}
            <img src="{{ asset(app.user.avatarPath) }}" alt="{{ app.user.name }}">
          {% else %}
            <span class="topbar__avatar-letter">{{ app.user.name|first|upper }}</span>
          {% endif %}
        </button>
        <div class="topbar__dropdown">
          <a href="{{ path('app_profile') }}" class="topbar__dropdown-item">
            <i class="bi bi-person"></i> Profile
          </a>
          <a href="{{ path('app_logout') }}" class="topbar__dropdown-item">
            <i class="bi bi-box-arrow-right"></i> Sign Out
          </a>
        </div>
      </div>
    {% else %}
      <a href="{{ path('app_login') }}" class="btn btn--sm btn--primary">Sign In</a>
    {% endif %}
  </div>
</header>