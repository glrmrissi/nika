{% extends 'base.html.twig' %}

{% block title %}Edit Profile | nika{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/pages/profile.css') }}">
{% endblock %}

{% block body %}
  <div class="profile__edit">
    <div class="profile__edit-header">
      <a href="{{ path('app_profile') }}" class="profile__back">
        <i class="bi bi-arrow-left"></i>
        Edit Profile
      </a>
    </div>

    {% if app.user.avatarPath %}
      <form method="post" action="{{ path('app_profile_avatar_remove') }}" id="remove-avatar-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('remove-avatar') }}">
      </form>
    {% endif %}

    <form id="discord-test-form" method="post" action="{{ path('app_profile_discord_test') }}" style="display:none;">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('discord-test') }}">
      <input type="hidden" name="webhook_url" id="discord-test-url" value="{{ app.user.discordWebhookUrl|default('') }}">
    </form>

    {{ form_start(form, {attr: {novalidate: true, class: 'profile__form'}}) }}

      <div class="profile__upload-area" id="upload-area">
        <label for="profile_form_avatar" class="profile__upload-preview-wrap">
          <div class="profile__upload-preview" id="avatar-preview">
            {% if app.user.avatarPath %}
              <img src="{{ asset(app.user.avatarPath) }}" alt="Avatar">
            {% else %}
              {{ app.user.name|first|upper }}
            {% endif %}
          </div>
          <div class="profile__upload-overlay">
            <i class="bi bi-camera"></i>
          </div>
        </label>
        {{ form_widget(form.avatar, {attr: {class: 'profile__file-input'}}) }}
        {{ form_errors(form.avatar) }}
        <div class="profile__upload-info">
          <span class="profile__upload-text">Click to upload</span>
          <span class="profile__upload-hint">JPEG, PNG or WebP &bull; Max 2MB</span>
          {% if app.user.avatarPath %}
            <button type="button"
              class="profile__upload-remove"
              data-modal
              data-modal-title="Remove Avatar"
              data-modal-message="Remove your profile photo?"
              data-modal-confirm="Remove"
              data-modal-cancel="Cancel">
              Remove photo
            </button>
          {% endif %}
        </div>
      </div>

      <div class="profile__dropzone-overlay" id="dropzone-overlay">
        <div class="profile__dropzone-overlay-inner">
          <i class="bi bi-cloud-arrow-up"></i>
          <span>Drop your photo here</span>
        </div>
      </div>

      <div class="profile__section">
        <h3 class="profile__section-title">Personal Info</h3>

        <div class="profile__field">
          {{ form_label(form.name, 'Name', {label_attr: {class: 'profile__label'}}) }}
          {{ form_widget(form.name, {attr: {class: 'profile__input', placeholder: 'Your name', 'data-maxlength': 100}}) }}
          <span class="char-count" data-for="profile_form_name" data-max="100"></span>
          {{ form_errors(form.name) }}
        </div>

        <div class="profile__field">
          {{ form_label(form.timezone, 'Timezone', {label_attr: {class: 'profile__label'}}) }}
          {{ form_widget(form.timezone, {attr: {class: 'profile__input'}}) }}
          {{ form_errors(form.timezone) }}
        </div>

        <div class="profile__field">
          {{ form_label(form.discordWebhookUrl, 'Discord Webhook URL', {label_attr: {class: 'profile__label'}}) }}
          {{ form_widget(form.discordWebhookUrl, {attr: {class: 'profile__input', placeholder: 'https://discord.com/api/webhooks/...', 'data-maxlength': 500}}) }}
          <p class="profile__hint">Used to send daily review reminders to your Discord channel.</p>
          {{ form_errors(form.discordWebhookUrl) }}

          <button type="submit" form="discord-test-form" id="discord-test-btn" class="btn btn--sm btn--secondary" style="margin-top:12px;" {{ not app.user.discordWebhookUrl ? 'disabled' }}>
            <i class="bi bi-send"></i> Send test reminder
          </button>
          <p class="profile__hint" id="discord-test-hint" style="margin-top:8px;{{ app.user.discordWebhookUrl ? ' display:none;' }}">Paste a URL to enable the test button. It must be a valid Discord webhook to work.</p>
        </div>
      </div>

      <div class="profile__section">
        <h3 class="profile__section-title">Kanji Settings</h3>

        <div class="profile__field">
          {{ form_label(form.kanjiClickAction, 'Kanji Image Search', {label_attr: {class: 'profile__label'}}) }}
          <div class="profile__radio-group">
            {% for child in form.kanjiClickAction %}
              <label class="profile__radio">
                {{ form_widget(child) }}
                <span>{{ child.vars.label }}</span>
              </label>
            {% endfor %}
          </div>
          {{ form_errors(form.kanjiClickAction) }}
        </div>
      </div>

      <div class="profile__section">
        <h3 class="profile__section-title">Profile README</h3>

        <div class="profile__field">
          {{ form_widget(form.readme, {attr: {class: 'profile__input profile__input--readme', rows: 12, placeholder: 'Write your profile README in Markdown...', 'data-maxlength': 5000}}) }}
          <span class="char-count" data-for="profile_form_readme" data-max="5000"></span>
          <p class="profile__hint">Supports Markdown formatting.</p>
          {{ form_errors(form.readme) }}
        </div>
      </div>

      <div class="profile__actions">
        <a href="{{ path('app_profile') }}" class="btn btn--secondary">Cancel</a>
        <button type="submit" class="btn btn--primary">Save changes</button>
      </div>

    {{ form_end(form) }}
  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script nonce="{{ csp_nonce('script') }}">
    (function() {
      var counters = document.querySelectorAll('.char-count');
      counters.forEach(function(el) {
        var input = document.getElementById(el.dataset.for);
        var max = parseInt(el.dataset.max, 10);
        if (!input) return;
        function update() {
          var len = input.value.length;
          el.textContent = len + ' / ' + max;
          el.classList.toggle('char-count--over', len > max);
        }
        input.addEventListener('input', update);
        update();
      });

      var input = document.getElementById('profile_form_avatar');
      var preview = document.getElementById('avatar-preview');
      var overlay = document.getElementById('dropzone-overlay');
      var dragCounter = 0;

      function updatePreview(file) {
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(ev) {
          preview.innerHTML = '<img src="' + ev.target.result + '" alt="Preview">';
          var text = document.querySelector('.profile__upload-text');
          if (text) text.textContent = file.name;
        };
        reader.readAsDataURL(file);
      }

      input.addEventListener('change', function() {
        updatePreview(this.files[0]);
      });

      document.addEventListener('dragenter', function(ev) {
        ev.preventDefault();
        dragCounter++;
        if (dragCounter === 1) {
          overlay.classList.add('profile__dropzone-overlay--visible');
        }
      });

      document.addEventListener('dragleave', function(ev) {
        ev.preventDefault();
        dragCounter--;
        if (dragCounter === 0) {
          overlay.classList.remove('profile__dropzone-overlay--visible');
        }
      });

      document.addEventListener('dragover', function(ev) {
        ev.preventDefault();
      });

      document.addEventListener('drop', function(ev) {
        ev.preventDefault();
        dragCounter = 0;
        overlay.classList.remove('profile__dropzone-overlay--visible');
        var file = ev.dataTransfer.files[0];
        if (file) {
          input.files = ev.dataTransfer.files;
          updatePreview(file);
        }
      });

      var webhookInput = document.getElementById('profile_form_discordWebhookUrl');
      var testBtn = document.getElementById('discord-test-btn');
      var testHint = document.getElementById('discord-test-hint');
      var testUrl = document.getElementById('discord-test-url');

      if (webhookInput && testBtn) {
        function updateTestButton() {
          var url = webhookInput.value.trim();
          var hasUrl = url.length > 0;
          testBtn.disabled = !hasUrl;
          if (testHint) {
            testHint.style.display = hasUrl ? 'none' : 'block';
          }
          if (testUrl) {
            testUrl.value = url;
          }
        }
        webhookInput.addEventListener('input', updateTestButton);
        updateTestButton();
      }
    })();
  </script>
{% endblock %}
