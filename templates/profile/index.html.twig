{% extends 'base.html.twig' %}

{% block title %}Profile | nika{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/pages/profile.css') }}">
{% endblock %}

{% block body %}
  <div class="profile__banner"></div>

  <section class="profile__header">
    {% if isOwnProfile %}
    <a href="{{ path('app_profile_edit') }}" class="profile__avatar-wrap">
    {% else %}
    <div class="profile__avatar-wrap">
    {% endif %}
      <div class="profile__avatar">
        {% if app.user.avatarPath %}
          <img src="{{ asset(app.user.avatarPath) }}" alt="Avatar">
        {% else %}
          {{ app.user.name|first|upper }}
        {% endif %}
      </div>
      {% if isOwnProfile %}
      <div class="profile__avatar-overlay">
        <i class="bi bi-camera"></i>
      </div>
      {% endif %}
    {% if isOwnProfile %}
    </a>
    {% else %}
    </div>
    {% endif %}
    <div class="profile__header-info">
      <div class="profile__name-row">
        <h2 class="page-title">{{ app.user.name }}</h2>
        {% if app.user.nameHistories is not empty %}
        <button class="profile__name-toggle" id="name-history-toggle" data-tooltip="Name history">
          <i class="bi bi-chevron-down"></i>
        </button>
        <div class="profile__name-history" id="name-history">
          {% for entry in app.user.nameHistories %}
          <div class="profile__name-history-item">
            <span class="profile__name-history-value">{{ entry.name }}</span>
            <span class="profile__name-history-date">{{ entry.changedAt|date('M d, Y') }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% if isOwnProfile %}
      <p class="page-subtitle">{{ app.user.email }}</p>
      {% endif %}
      <div class="profile__badge-group">
        {% if app.user.totpEnabled %}
          <span class="badge badge--primary"><i class="bi bi-shield-check"></i> 2FA Active</span>
        {% else %}
          <span class="badge badge--secondary"><i class="bi bi-shield"></i> 2FA Inactive</span>
        {% endif %}
        {% if app.user.isVerified %}
          <span class="badge badge--primary"><i class="bi bi-patch-check"></i> Verified</span>
        {% endif %}
      </div>
    </div>
    {% if isOwnProfile %}
    <div class="profile__header-actions">
      <a href="{{ path('app_profile_edit') }}" class="btn btn--primary btn--sm">
        <i class="bi bi-pencil"></i> Edit
      </a>
    </div>
    {% endif %}
  </section>

  {% if app.user.readme %}
  <div class="profile__readme">{{ app.user.readme|markdown }}</div>
  {% endif %}

  <div class="profile__stats">
    <article class="stat-card">
      <div class="stat-card__icon"><i class="bi bi-check-circle"></i></div>
      <span class="stat-card__value">{{ reviewedToday }}</span>
      <span class="stat-card__label">Reviewed today</span>
    </article>
    <article class="stat-card">
      <div class="stat-card__icon"><i class="bi bi-fire"></i></div>
      <span class="stat-card__value">{{ streak }}</span>
      <span class="stat-card__label">Day streak</span>
    </article>
    <article class="stat-card">
      <div class="stat-card__icon"><i class="bi bi-clock"></i></div>
      <span class="stat-card__value">{{ dueCount }}</span>
      <span class="stat-card__label">Due</span>
    </article>
    <article class="stat-card">
      <div class="stat-card__icon"><i class="bi bi-book"></i></div>
      <span class="stat-card__value">{{ totalKanji }}</span>
      <span class="stat-card__label">Total kanji</span>
    </article>
  </div>

  {% if heatmap is not empty %}
  <div class="profile__section profile__section--heatmap">
    <div class="profile__section-header">
      <h3 class="section-title">Activity</h3>
      <div class="heatmap__legend">
        <span class="heatmap__legend-label">Less</span>
        <span class="hm-swatch" data-level="0"></span>
        <span class="hm-swatch" data-level="1"></span>
        <span class="hm-swatch" data-level="2"></span>
        <span class="hm-swatch" data-level="3"></span>
        <span class="hm-swatch" data-level="4"></span>
        <span class="heatmap__legend-label">More</span>
      </div>
    </div>
    <div class="heatmap__grid" id="profile-heatmap"></div>
  </div>
  {% endif %}

  {% if isOwnProfile %}
  <div class="profile__section">
    <h3 class="section-title">Account</h3>
    <div class="account-card">
      <div class="account-card__email">
        <span class="account-card__email-address">{{ app.user.email }}</span>
      </div>
      <div class="account-card__meta">
        <span class="account-card__meta-item">
          <i class="bi bi-patch-check"></i>
          {{ app.user.isVerified ? 'Verified' : 'Not verified' }}
        </span>
        <span class="account-card__meta-item">
          <i class="bi bi-calendar"></i>
          Member since {{ app.user.createdAt|date('M d, Y') }}
        </span>
        <span class="account-card__meta-item">
          <i class="bi bi-shield-lock"></i>
          {% if app.user.totpEnabled %}
            2FA Active
          {% else %}
            <a href="{{ path('app_2fa_setup') }}">Set up 2FA</a>
          {% endif %}
        </span>
      </div>
    </div>
  </div>
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function() {
      var toggle = document.getElementById('name-history-toggle');
      var history = document.getElementById('name-history');
      if (!toggle || !history) return;
      toggle.addEventListener('click', function(e) {
        e.stopPropagation();
        history.classList.toggle('profile__name-history--open');
      });
      document.addEventListener('click', function(e) {
        if (!history.contains(e.target) && e.target !== toggle) {
          history.classList.remove('profile__name-history--open');
        }
      });
    })();
  </script>
  {% if heatmap is not empty %}
  <script>
    (function() {
      var data = {{ heatmap|json_encode|raw }};
      var grid = document.getElementById('profile-heatmap');
      if (!grid || !data.length) return;

      var cell = 11;
      var gap = 3;
      var step = cell + gap;
      var labelW = 28;
      var monthH = 20;

      var dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      var visDays = {1: 1, 3: 1, 5: 1};
      var monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

      var weeks = {};
      for (var i = 0; i < data.length; i++) {
        var dt = new Date(data[i].date + 'T00:00:00');
        var dow = dt.getDay();
        var sun = new Date(dt);
        sun.setDate(dt.getDate() - dow);
        var wk = sun.getTime();
        if (!weeks[wk]) { weeks[wk] = []; weeks[wk].sun = sun; }
        weeks[wk][dow] = data[i];
      }

      var keys = Object.keys(weeks).sort(function(a, b) { return a - b; });
      var nw = keys.length;
      var firstWeekOfMonth = {};
      for (var k = 0; k < nw; k++) {
        var m = weeks[keys[k]].sun.getMonth();
        if (firstWeekOfMonth[m] === undefined) firstWeekOfMonth[m] = k;
      }

      var w = labelW + (nw * step);
      var h = monthH + (7 * step);

      var svg = '<svg class="heatmap__svg" viewBox="0 0 ' + w + ' ' + h + '" width="' + w + '">';

      for (var m = 0; m < 12; m++) {
        if (firstWeekOfMonth[m] !== undefined) {
          svg += '<text x="' + (labelW + firstWeekOfMonth[m] * step) + '" y="14" class="hm-month">' + monthNames[m] + '</text>';
        }
      }

      for (var row = 0; row < 7; row++) {
        if (visDays[row]) {
          var ty = monthH + (row * step) + (step / 2) + 1;
          svg += '<text x="' + (labelW - 6) + '" y="' + ty + '" class="hm-day">' + dayNames[row] + '</text>';
        }
      }

      for (var row = 0; row < 7; row++) {
        for (var k = 0; k < nw; k++) {
          var week = weeks[keys[k]];
          var day = week[row];
          var x = labelW + (k * step);
          var y = monthH + (row * step);
          if (day && day.count > 0) {
            var c = day.count;
            var lv = c <= 3 ? 1 : c <= 8 ? 2 : c <= 16 ? 3 : 4;
            svg += '<rect x="' + x + '" y="' + y + '" width="' + cell + '" height="' + cell + '" data-level="' + lv + '" data-tooltip="' + day.date + ': ' + c + ' reviews"/>';
          } else {
            svg += '<rect x="' + x + '" y="' + y + '" width="' + cell + '" height="' + cell + '" data-level="0"/>';
          }
        }
      }

      svg += '</svg>';
      grid.innerHTML = svg;
    })();
  </script>
  {% endif %}
{% endblock %}
