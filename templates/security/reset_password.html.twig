{% extends 'base.html.twig' %}

{% block title %}Reset Password | nika{% endblock %}

{% block topbar %}{% endblock %}
{% block mobile_nav %}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/pages/auth.css') }}">
{% endblock %}

{% block body_class %}app-main--full{% endblock %}

{% block body %}
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-card__header">
        <div class="auth-card__logo">K</div>
        <h1>Reset Password</h1>
        <p class="auth-card__subtitle">Choose a new password for your account.</p>
      </div>

      {{ form_start(form, {attr: {class: 'auth-form'}}) }}
        <div class="form-field">
          <label for="{{ form.password.first.vars.id }}">New password</label>
          {{ form_widget(form.password.first, {attr: {class: 'form-input', autofocus: true, placeholder: 'New password'}}) }}
          {{ form_errors(form.password.first) }}
        </div>

        <div class="form-field">
          <label for="{{ form.password.second.vars.id }}">Confirm password</label>
          {{ form_widget(form.password.second, {attr: {class: 'form-input', placeholder: 'Confirm password'}}) }}
          {{ form_errors(form.password.second) }}
        </div>

        <button type="submit" class="btn btn--primary">Reset Password</button>
      {{ form_end(form) }}

      <div class="auth-links">
        <a href="{{ path('app_login') }}">Back to login</a>
      </div>
    </div>
  </div>
{% endblock %}
