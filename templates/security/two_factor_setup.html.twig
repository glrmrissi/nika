{% extends 'base.html.twig' %}

{% block title %}Set Up 2FA | KanjiReview{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/pages/auth.css') }}">
{% endblock %}

{% block body %}
  <div class="auth-page" style="padding-top:48px">
    <div class="auth-card" style="max-width:480px;text-align:center">
      <h1>Two-Factor Authentication</h1>
      <p>Scan the QR code with Microsoft Authenticator and confirm the code.</p>

      <div style="margin:24px auto;max-width:256px">
        <img src="{{ qrCode }}" alt="TOTP QR Code" style="width:100%;height:auto;border-radius:8px">
      </div>

      <div style="font-size:13px;color:var(--color-secondary);word-break:break-all;background:var(--color-surface-container-low);padding:8px 12px;border-radius:6px;margin-bottom:24px;font-family:monospace">
        {{ secret }}
      </div>

      {{ form_start(form, {attr: {class: 'auth-form', style: 'max-width:280px;margin:0 auto'}}) }}
        {{ form_row(form.code) }}
        <button type="submit" class="btn btn--primary">Enable 2FA</button>
      {{ form_end(form) }}

      <div class="auth-links">
        <a href="{{ path('app_home') }}">Skip for now</a>
      </div>
    </div>
  </div>
{% endblock %}
