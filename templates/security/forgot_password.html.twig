{% extends 'base.html.twig' %}

{% block title %}Forgot Password | nika{% endblock %}

{% block topbar %}{% endblock %}
{% block mobile_nav %}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/pages/auth.css') }}">
{% endblock %}

{% block body_class %}app-main--full{% endblock %}

{% block body %}
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-card__header">
        <div class="auth-card__logo">K</div>
        <h1>Forgot Password</h1>
        <p class="auth-card__subtitle">Enter your email and we'll send instructions.</p>
      </div>

      {{ form_start(form, {attr: {class: 'auth-form'}}) }}
        <div class="form-field">
          {{ form_label(form.email, 'Email', {label_attr: {class: 'form-label'}}) }}
          {{ form_widget(form.email, {attr: {class: 'form-input', autofocus: true}}) }}
          {{ form_errors(form.email) }}
        </div>

        <button type="submit" class="btn btn--primary">Send instructions</button>
      {{ form_end(form) }}

      <div class="auth-links">
        <a href="{{ path('app_login') }}">Back to login</a>
      </div>
    </div>
  </div>
{% endblock %}
