{% extends 'base.html.twig' %}

{% block title %}Dashboard | nika{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/pages/dashboard.css') }}">
{% endblock %}

{% block body %}
  {% if loginSuccess %}
    <div class="login-overlay" id="login-overlay">
      <img src="{{ asset('assets/anime-white-version.png') }}" alt="" class="login-overlay__img login-overlay__img--dark" width="280" height="280">
      <img src="{{ asset('assets/anime-black-version.png') }}" alt="" class="login-overlay__img login-overlay__img--light" width="280" height="280">
    </div>
  {% endif %}
  <section class="dashboard__welcome">
    <h2 class="page-title">Hi{% if userName %}, {{ userName }}{% endif %}</h2>
    <p class="page-subtitle">Here is your progress today.</p>
  </section>

  <div class="dashboard__grid">

    <article class="d-card d-card--mastery">
      <div class="d-card__header">
        <div>
          <h3 class="section-title" style="margin-bottom:2px;">Mastery Overview</h3>
          <p class="d-card__subtitle">Current progress across all levels.</p>
        </div>
        <span class="d-badge">Total: {{ totalCount }} kanji</span>
      </div>
      <div class="mastery__progress">
        {% if byLevel is empty %}
          <p style="padding:24px 0;text-align:center;color:var(--color-secondary);font-size:14px;">
            No kanji selected yet. <a href="{{ path('app_kanji_list') }}" style="color:var(--color-primary);">Browse kanji</a> to start.
          </p>
        {% else %}
          {% for level in byLevel %}
            <div class="mastery__row">
              <div class="mastery__row-header">
                <span>Kanji {{ level.jlptLevel }}</span>
                <span class="mastery__row-meta">{{ level.total }} kanji &middot; {{ level.percentage }}%</span>
              </div>
              <div class="pbar">
                <div class="pbar__fill" style="width: {{ level.percentage }}%;"></div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </article>

    <article class="d-card d-card--reviews">
      <div class="d-card__header" style="margin-bottom:20px;">
        <h3 class="section-title" style="margin-bottom:2px;">Reviews</h3>
      </div>
      <div class="rstats">
        <div class="rstats__item">
          <span class="rstats__value">{{ reviewedToday }}</span>
          <span class="rstats__label">Today</span>
        </div>
        <div class="rstats__item">
          <span class="rstats__value">{{ thisWeek }}</span>
          <span class="rstats__label">This Week</span>
        </div>
        <div class="rstats__item">
          <span class="rstats__value">{{ thisMonth }}</span>
          <span class="rstats__label">This Month</span>
        </div>
        <div class="rstats__item">
          <span class="rstats__value">{{ thisYear }}</span>
          <span class="rstats__label">This Year</span>
        </div>
      </div>
      <div class="rstats__due">
        <span class="rstats__due-value">{{ dueCount }}</span>
        <span class="rstats__due-label">kanji due</span>
      </div>
      <a href="{{ path('app_review') }}" class="btn btn--primary" style="display:flex;width:100%;padding:12px;font-size:15px;">
        <i class="bi bi-eye"></i> Review Now
      </a>
    </article>

    <article class="d-card d-card--recent">
      <div class="d-card__header">
        <h3 class="section-title" style="margin-bottom:2px;">Recently Studied</h3>
        <a href="{{ path('app_kanji_recent') }}" style="font-size:13px;color:var(--color-primary);font-weight:500;text-decoration:none;">View All</a>
      </div>
      <div class="recent__grid">
        {% for item in recent %}
          <div class="rcard">
            <span class="rcard__char">{{ item.character }}</span>
            <span class="rcard__meaning">{{ item.meaning }}</span>
            <div class="rcard__bar"><div class="rcard__bar-fill" style="width:{{ item.mastery }}%"></div></div>
          </div>
        {% else %}
          <p style="grid-column:1/-1;color:var(--color-secondary);font-size:14px;text-align:center;padding:24px 0;">No kanji studied yet.</p>
        {% endfor %}
      </div>
    </article>

  </div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script nonce="{{ csp_nonce('script') }}">
  document.addEventListener('DOMContentLoaded', function () {
    function animateValue(el, duration) {
      var start = 0;
      var end = parseInt(el.textContent, 10);
      if (isNaN(end) || end === 0) return;
      var startTime = performance.now();
      el.textContent = start;
      function tick(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(start + (end - start) * eased);
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    document.querySelectorAll('.rstats__value, .rstats__due-value').forEach(function (el) {
      animateValue(el, 600);
    });
  });
  </script>
{% endblock %}
