{
    "name": "nika/kanji-review",
    "description": "Personalized Japanese kanji and grammar review app.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "endroid/qr-code-bundle": "^7.0",
        "league/commonmark": "^2.10",
        "nelmio/security-bundle": "^3.9",
        "scheb/2fa-bundle": "^8.6",
        "scheb/2fa-totp": "^8.6",
        "scottlaurent/fsrs": "^0.1",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/html-sanitizer": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "setup": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "composer install",
            "php bin/console doctrine:database:create --if-not-exists",
            "php bin/console doctrine:migrations:migrate --no-interaction",
            "php bin/console app:kanji:seed",
            "php bin/console app:admin:create",
            "@auto-scripts"
        ],
        "dev": "php -S localhost:8000 -t public",
        "db:migrate": "php bin/console doctrine:migrations:migrate --no-interaction",
        "db:seed": [
            "php bin/console app:kanji:seed",
            "php bin/console app:grammar:seed"
        ],
        "db:reset": [
            "php bin/console doctrine:database:drop --force",
            "php bin/console doctrine:database:create",
            "@composer db:migrate",
            "@composer db:seed"
        ],
        "lint:php": "php scripts/lint.php",
        "lint:twig": "php bin/console lint:twig templates",
        "lint:container": "php bin/console lint:container",
        "lint:yaml": "php bin/console lint:yaml config",
        "lint": [
            "@lint:php",
            "@lint:twig",
            "@lint:container",
            "@lint:yaml"
        ],
        "check": "php scripts/check.php",
        "test": "@check",
        "setup:hooks": [
            "git config core.hooksPath .githooks",
            "php -r \"chmod('.githooks/pre-commit', 0755);\""
        ],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
